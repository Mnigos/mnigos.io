---
import { sortNewestFirst } from '../../blog/domain/post.helper'
import { getPublishedPosts } from '../../blog/infrastructure/posts.query'
import ContributionCell from '../../contributions/presentation/contribution-cell.astro'
import { loadContributionYears } from '../../contributions/infrastructure/contributions.client'
import { PROFILE } from '../../profile/content/profile.content'
import { formatFactValue } from '../../profile/domain/profile-format.helper'
import ProductFacts from '../../profile/presentation/product-facts.astro'
import { HOME_PAGE } from '../content/home-page.content'
import Layout from './layout.astro'
import YearStrip from './year-strip.astro'

const today = new Date().toISOString().slice(0, 10)
const contributionYears = await loadContributionYears()
const posts = sortNewestFirst(await getPublishedPosts()).slice(0, 5)

const newTab = (url: string) =>
  url.startsWith('https://') ? { target: '_blank', rel: 'noreferrer' } : {}

const sectionHead = 'flex items-baseline justify-between gap-4 border-b-2 border-ink pb-3'
const sectionLink = 'text-small/5.25 text-dim hover:text-accent'
const row =
  'grid grid-cols-aside items-baseline gap-x-5 gap-y-1 border-b border-line py-3.25 max-xs:grid-cols-1'
const rowTitle = 'text-title font-semibold hover:text-accent'
const rowValue = 'whitespace-nowrap text-right text-dim max-xs:text-left'
---

<Layout title={HOME_PAGE.title} description={HOME_PAGE.description}>
  <section class="grid grid-cols-aside items-end gap-x-7 gap-y-3.5 pb-7 max-xs:grid-cols-1">
    <div class="max-w-lede text-lede text-dim">
      <h1 class="inline font-bold text-ink">{PROFILE.name}.</h1>{' '}{PROFILE.intro}
    </div>
    <div class="flex flex-wrap gap-1.5 pb-0.75">
      {
        PROFILE.links.map(({ label, url }) => (
          <a
            href={url}
            {...newTab(url)}
            class="border border-line-strong px-2.75 py-1.25 text-caption font-medium text-ink hover:border-accent hover:text-accent"
          >
            {label}
          </a>
        ))
      }
    </div>
  </section>

  <section aria-label={HOME_PAGE.contributions.label} class="grid gap-4">
    {
      contributionYears.toReversed().map(contributionYear => (
        <YearStrip contributionYear={contributionYear} today={today} />
      ))
    }
  </section>
  <div
    class="mt-3.5 ml-18.5 flex items-center gap-1.25 text-caption/4.75 text-faint max-xs:ml-0"
  >
    <span>{HOME_PAGE.contributions.less}</span>
    {[0, 1, 2, 3, 4, 5, 6, 7, 8].map(level => <ContributionCell level={level} class="w-2.5" />)}
    <span>{HOME_PAGE.contributions.more}</span>
    <span class="ml-auto max-xs:hidden">{HOME_PAGE.contributions.note}</span>
  </div>

  <div class="mt-8.5">
    <ProductFacts product={PROFILE.product} />
  </div>

  <section class="mt-11">
    <div class={sectionHead}>
      <h2 class="heading text-heading">{HOME_PAGE.openSource.heading}</h2>
      <a href={PROFILE.openSource.link.url} {...newTab(PROFILE.openSource.link.url)} class={sectionLink}>
        {PROFILE.openSource.link.label}<span aria-hidden="true"> ↗</span>
      </a>
    </div>
    <ul>
      {
        PROFILE.openSource.projects.map(({ name, note, url, fact }) => (
          <li class={row}>
            <span>
              <a href={url} {...newTab(url)} class={rowTitle}>{name}</a>
              {note && <small class="mt-px block text-small text-dim">{note}</small>}
            </span>
            <span class:list={[rowValue, 'text-small']}>
              <b class="numeric mr-1 text-title/6.5 font-bold text-accent">
                {formatFactValue(fact.value)}
              </b>
              {fact.label}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-11">
    <div class={sectionHead}>
      <h2 class="heading text-heading">{HOME_PAGE.blog.heading}</h2>
      <a href="/blog" class={sectionLink}>{HOME_PAGE.blog.allPosts}</a>
    </div>
    <ul>
      {
        posts.map(post => {
          const date = post.data.publishedAt.toISOString().slice(0, 10)

          return (
            <li class={row}>
              <a href={`/blog/${post.id}`} class={rowTitle}>{post.data.title}</a>
              <time datetime={date} class:list={[rowValue, 'numeric text-caption/5.25']}>{date}</time>
            </li>
          )
        })
      }
    </ul>
  </section>
</Layout>
