---
import { formatPostDate, sortNewestFirst } from '../../blog/domain/post.helper'
import { getPublishedPosts } from '../../blog/infrastructure/posts.query'
import Layout from './layout.astro'

const posts = sortNewestFirst(await getPublishedPosts()).slice(0, 3)
---

<Layout
  title="Igor Makowski · mnigos"
  description="Software engineer building for the web. Portfolio and blog."
>
  <section>
    <h1 class="heading text-3xl">
      Igor Makowski
    </h1>
    <p class="mt-4 max-w-prose leading-relaxed text-dim">
      Software engineer building for the web with TypeScript, React, and
      whatever else the problem calls for. Currently working on{' '}
      <a
        href="https://rigtch.fm"
        target="_blank"
        rel="noreferrer"
        class="font-medium text-ink underline decoration-accent decoration-2 underline-offset-4 hover:text-accent"
      >
        rigtch.fm
      </a>.
    </p>
  </section>

  {
    posts.length > 0 && (
      <section class="mt-16">
        <h2 class="heading text-sm uppercase text-dim">
          Recent posts
        </h2>
        <ul class="mt-4 space-y-4">
          {posts.map(post => (
            <li>
              <a href={`/blog/${post.id}`} class="group block">
                <span class="font-semibold group-hover:text-accent">
                  {post.data.title}
                </span>
                <time
                  datetime={post.data.publishedAt.toISOString()}
                  class="numeric ml-3 text-sm text-dim"
                >
                  {formatPostDate(post.data.publishedAt, 'short')}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
