---
import { getYearWeeks } from '../../contributions/domain/contribution-weeks.helper'
import type { ContributionYear } from '../../contributions/domain/contribution.types'
import ContributionCell from '../../contributions/presentation/contribution-cell.astro'
import { PROFILE } from '../../profile/content/profile.content'
import { getJobSegments } from '../domain/job-segments.helper'

interface Props {
  contributionYear: ContributionYear
  today: string
}

const { contributionYear, today } = Astro.props
const { year, total } = contributionYear

const weeks = getYearWeeks(contributionYear, today)
const segments = getJobSegments(year, PROFILE.jobs)

const formatTitle = (count: number, date: string) =>
  `${count} ${count === 1 ? 'contribution' : 'contributions'} on ${date}`
---

<div class="grid grid-cols-year items-end gap-3 max-xs:grid-cols-1 max-xs:gap-1">
  <div class="pb-0.5 max-xs:flex max-xs:items-baseline max-xs:gap-2.5">
    <div class="heading text-figure leading-none">{year}</div>
    <div class="numeric mt-1.5 text-micro text-faint">{total.toLocaleString('en-US')}</div>
  </div>
  <div class="flex min-w-0 gap-2.25">
    {
      segments.map(({ fromWeek, toWeek, label }) => (
        <div class="min-w-0" style={`flex: ${toWeek - fromWeek} ${toWeek - fromWeek} 0`}>
          <div class="h-5.5 truncate text-caption text-dim max-xs:text-micro">
            {label && <b class="font-semibold text-ink">{label.company}</b>}
            {label?.role && ` · ${label.role}`}
          </div>
          <div class="grid auto-cols-fr grid-flow-col gap-0.5">
            {weeks.slice(fromWeek, toWeek).map(week => (
              <div class="grid grid-rows-7 gap-0.5">
                {week.map(cell => {
                  if (cell.kind === 'outside') return <div class="aspect-square" />
                  if (cell.kind === 'future') return <ContributionCell level={0} />
                  return (
                    <ContributionCell
                      level={cell.level}
                      title={formatTitle(cell.count, cell.date)}
                    />
                  )
                })}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
