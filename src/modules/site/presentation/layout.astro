---
import { Font } from 'astro:assets'
import '../../../styles/global.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props

const sections = [
  { href: '/work', label: 'Work' },
  { href: '/blog', label: 'Blog' },
  { href: 'https://rigtch.fm', label: 'rigtch.fm' },
]

const newTab = (href: string) =>
  href.startsWith('https://') ? { target: '_blank', rel: 'noreferrer' } : {}

const profiles = [
  { href: 'https://github.com/Mnigos', label: 'GitHub' },
  { href: 'https://x.com/mnigos0', label: 'X' },
  { href: 'https://www.linkedin.com/in/igor-makowski-b30684206/', label: 'LinkedIn' },
  { href: '/rss.xml', label: 'RSS' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="mnigos.io"
      href={new URL('rss.xml', Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-martian-mono" preload />
  </head>
  <body class="text-ink antialiased">
    <div class="mx-auto flex min-h-dvh max-w-page flex-col px-4 xs:px-7">
      <header
        class="flex flex-wrap items-center gap-x-5.5 gap-y-2 border-b border-line py-4.5"
      >
        <a href="/" class="heading flex items-center gap-2.5 text-title">
          <svg viewBox="0 0 100 112" aria-hidden="true" class="h-6.5 w-auto text-accent">
            <path
              d="M 50 0 L 100 28 L 100 84 L 70 100.8 L 70 52 L 58 52 L 58 107.5 L 50 112 L 42 107.5 L 42 52 L 30 52 L 30 100.8 L 0 84 L 0 28 Z"
              fill="currentColor"
            />
          </svg>
          <span>mnigos<span class="text-faint">.io</span></span>
        </a>
        <nav
          class="order-last flex w-full gap-5 text-small/5 text-dim xs:order-none xs:ml-auto xs:w-auto"
        >
          {
            sections.map(({ href, label }) => (
              <a
                href={href}
                {...newTab(href)}
                aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}
                class="border-b-2 border-transparent py-0.75 hover:text-ink current-page:border-accent current-page:text-ink"
              >
                {label}
                {href.startsWith('https://') && <span aria-hidden="true"> ↗</span>}
              </a>
            ))
          }
        </nav>
        <a
          href="#contact"
          class="ml-auto bg-accent px-3.5 py-1.75 text-caption/5.25 font-bold text-on-accent hover:bg-level-5 xs:ml-0"
        >
          Contact
        </a>
      </header>

      <main class="flex-1 py-8">
        <slot />
      </main>

      <footer
        id="contact"
        class="flex flex-wrap items-center justify-between gap-4 border-t border-line py-8 text-small/5 text-dim"
      >
        <span>© {new Date().getFullYear()} Igor Makowski</span>
        <div class="flex flex-wrap gap-1.5">
          {
            profiles.map(({ href, label }) => (
              <a
                href={href}
                {...newTab(href)}
                class="border border-line-strong px-2.75 py-1.25 text-caption/4.75 font-medium text-ink hover:border-accent hover:text-accent"
              >
                {label}
              </a>
            ))
          }
        </div>
      </footer>
    </div>
  </body>
</html>
