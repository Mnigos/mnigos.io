---
import Layout from '../../site/presentation/layout.astro'
import { formatIsoDate, sortNewestFirst } from '../domain/post.helper'
import { getPublishedPosts } from '../infrastructure/posts.query'

const posts = sortNewestFirst(await getPublishedPosts())
---

<Layout title="Blog · mnigos" description="Writing about software engineering.">
  <h1 class="heading border-b-2 border-ink pb-3 text-heading">
    Blog
  </h1>
  <ul>
    {
      posts.map(post => {
        const date = formatIsoDate(post.data.publishedAt)

        return (
          <li class="border-b border-line">
            <a
              href={`/blog/${post.id}`}
              class="group grid items-baseline gap-x-5 gap-y-1 py-3.25 xs:grid-cols-aside"
            >
              <span class="text-title font-semibold group-hover:text-accent">
                {post.data.title}
                <small class="mt-px block text-small font-normal text-dim">
                  {post.data.description}
                </small>
              </span>
              <time datetime={date} class="numeric text-caption/5.25 whitespace-nowrap text-dim xs:text-right">
                {date}
              </time>
            </a>
          </li>
        )
      })
    }
  </ul>
</Layout>
