---
import type { ContributionYear } from '../../contributions/domain/contribution.types'
import WeeklyStrip from '../../contributions/presentation/weekly-strip.astro'
import { formatMonth } from '../../profile/domain/profile-format.helper'
import type { Job } from '../../profile/domain/profile.schemas'
import { getJobGroupRows } from '../domain/job-groups.helper'
import { getJobPeriodRange, WEEKLY_THRESHOLDS } from '../domain/job-weeks.helper'
import DefinitionList from './definition-list.astro'
import WorkSection from './work-section.astro'

interface Props {
  job: Job
  years: ContributionYear[]
  today: string
  legend?: string
}

const { job, years, today, legend } = Astro.props
const { start, end } = job.period
const rows = getJobGroupRows(job.groups)
---

<WorkSection
  heading={job.company}
  url={job.url}
  aside={`${formatMonth(start)} to ${end ? formatMonth(end) : 'now'}`}
  subheading={job.role}
>
  <WeeklyStrip
    years={years}
    period={getJobPeriodRange(job.period, today)}
    thresholds={WEEKLY_THRESHOLDS}
    legend={legend}
  />
  <p class="mt-4 max-w-measure text-copy text-body">{job.description}</p>
  {
    rows.length > 0 && (
      <DefinitionList>
        {rows.map(row => (
          <>
            <dt>{row.term}</dt>
            <dd>
              {'items' in row ? (
                <ul class="grid gap-1.75">
                  {row.items.map(item => (
                    <li class="bullet">
                      {item}
                    </li>
                  ))}
                </ul>
              ) : (
                row.text
              )}
            </dd>
          </>
        ))}
      </DefinitionList>
    )
  }
</WorkSection>
