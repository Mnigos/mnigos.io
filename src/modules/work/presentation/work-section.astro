---
interface Props {
  heading: string
  url?: string
  aside: string
  subheading?: string
}

const { heading, url, aside, subheading } = Astro.props
---

<section class="mt-9.5 border-t-2 border-ink pt-4.5">
  <div class="grid grid-cols-aside items-baseline gap-x-5 gap-y-0.5">
    <h2 class="heading text-headline">
      {
        url ? (
          <a href={url} target="_blank" rel="noreferrer" class="hover:text-accent">
            {heading}
            <span aria-hidden="true"> ↗</span>
          </a>
        ) : (
          heading
        )
      }
    </h2>
    <span class="numeric text-caption/5.25 whitespace-nowrap text-dim">{aside}</span>
    {subheading && <span class="col-span-full text-title text-dim">{subheading}</span>}
  </div>
  <slot />
</section>
