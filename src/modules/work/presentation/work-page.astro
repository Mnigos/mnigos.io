---
import { loadContributionYears } from '../../contributions/infrastructure/contributions.client'
import { PROFILE } from '../../profile/content/profile.content'
import ProductFacts from '../../profile/presentation/product-facts.astro'
import Layout from '../../site/presentation/layout.astro'
import DefinitionList from './definition-list.astro'
import JobSection from './job-section.astro'
import WorkSection from './work-section.astro'

const { name, product, jobs, stack, work } = PROFILE
const years = await loadContributionYears()
const today = new Date().toISOString().slice(0, 10)
const description = `Work by ${name}: ${[product.name, ...jobs.map(({ company }) => company)].join(', ')}.`
---

<Layout title="Work · mnigos" description={description}>
  <div class="py-1.5">
    <h1 class="heading text-display xs:text-display-lg">Work</h1>
    <p class="mt-3.5 max-w-intro text-copy text-dim">{work.intro}</p>
  </div>

  <WorkSection
    heading={product.name}
    url={product.url}
    aside={product.kind}
    subheading={product.tagline}
  >
    <p class="mt-4 max-w-measure text-copy text-body">{product.summary}</p>
    <div class="mt-5">
      <ProductFacts product={product} factsOnly />
    </div>
    <DefinitionList>
      <dt>What I do</dt>
      <dd>{product.whatIDo}</dd>
      <dt>Stack</dt>
      <dd>{product.stack}</dd>
    </DefinitionList>
  </WorkSection>

  {
    jobs.map((job, index) => (
      <JobSection
        job={job}
        years={years}
        today={today}
        legend={index === 0 ? work.weeklyStripLegend : undefined}
      />
    ))
  }

  <WorkSection heading="Stack" aside="and where I used it">
    <DefinitionList>
      {
        stack.map(({ title, entries }) => (
          <>
            <dt>{title}</dt>
            <dd>
              <ul class="grid gap-2">
                {entries.map(({ technology, usedAt }) => (
                  <li class="grid grid-cols-1 gap-x-4 gap-y-0.5 xs:grid-cols-stack">
                    <b class="font-semibold text-ink">{technology}</b>
                    <span class="text-dim">{usedAt.join(', ')}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </>
        ))
      }
    </DefinitionList>
  </WorkSection>
</Layout>
