---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

const published = await getCollection('blog', ({ data }) => !data.draft)
const posts = published.toSorted(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
)
---

<Layout title="Blog · mnigos" description="Writing about software engineering.">
  <h1 class="heading text-2xl">
    Blog
  </h1>
  <ul class="mt-8 space-y-8">
    {
      posts.map(post => (
        <li>
          <a href={`/blog/${post.id}`} class="group block">
            <h2 class="font-semibold group-hover:text-accent">
              {post.data.title}
            </h2>
            <p class="mt-1 text-sm text-dim">
              {post.data.description}
            </p>
            <time
              datetime={post.data.publishedAt.toISOString()}
              class="numeric mt-1 block text-sm text-dim"
            >
              {post.data.publishedAt.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
